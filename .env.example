# Local preview (http://localhost:8080)
HTTP_PORT=8080

# Auto-created admin account (dev only — change for anything public)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com

# Database (internal to the compose network — never exposed)
DB_NAME=baboul_wp
DB_USER=baboul
DB_PASSWORD=baboulpass
DB_ROOT_PASSWORD=rootpass

# DEV-ONLY demo content (programmes, replays, news, schedule...). 0 = start empty.
SEED_DEMO=1
